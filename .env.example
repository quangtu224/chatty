# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://chatty:chatty@127.0.0.1:5432/chatty
MIGRATION_DATABASE_URL=postgres://chatty:chatty@127.0.0.1:5432/chatty
TEST_DATABASE_URL=postgres://chatty:chatty@127.0.0.1:5432/chatty_test
APP_ORIGIN=http://127.0.0.1:5173
PORT=3000
NODE_ENV=development
# Local Compose HTTP port. The release script sets RELEASE_SHA from clean Git HEAD.
APP_PORT=3000
# Hosting only: reverse proxies in front of the app (usually 1). Leave unset locally.
# TRUST_PROXY=1
# Production DATABASE_URL/MIGRATION_DATABASE_URL must end with ?sslmode=verify-full
# (plus &sslrootcert=/path/to/ca.crt for Supabase, or set NODE_EXTRA_CA_CERTS).
# M2: server-only Giphy key from https://developers.giphy.com
GIPHY_API_KEY=
