{
  "name": "chatty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "lint": "eslint . --max-warnings 0",
    "smoke": "node scripts/smoke.mjs",
    "release:local": "node --env-file-if-exists=.env scripts/release-local.mjs",
    "verify": "npm run lint && node --test src/model.test.js src/services/api.test.js src/services/chat-model.test.js && npm run test:server && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "test": "node --test src/model.test.js",
    "test:server": "node --env-file-if-exists=.env --test --test-concurrency=1 server/*.test.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=24.7"
  }
}
